---
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="author" content="Daniel Alzein" />
    <meta name="description" content="My portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Daniel Alzein</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  :root {
    --background: hsl(0 0% 98%);
    --foreground: hsl(0 0% 0%);
    --foreground-secondary: hsl(0 0% 30%);
    --accent-1: hsl(0 0% 100%);
    --accent-2: hsl(0 0% 96%);
    --accent-3: hsl(0 0% 92%);
    --accent-4: hsl(0 0% 88%);
    --border: hsl(0 0% 0% / 0.1);
  }

  :root.dark {
    --background: hsl(0 0% 0%);
    --foreground: hsL(0 0% 100%);
    --foreground-secondary: hsl(0 0% 83%);
    --accent-1: hsl(0 0% 4%);
    --accent-2: hsl(0 0% 8%);
    --accent-3: hsl(0 0% 12%);
    --accent-4: hsl(0 0% 16%);
    --border: hsl(0 0% 100% / 0.2);
  }

  :global(*) {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  body {
    font-family: "Google Sans", sans-serif;
    background: var(--background);
    color: var(--foreground);
    max-width: 80rem;
    margin: auto;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    padding: 0 1.5rem 3rem;
  }

  :global(svg) {
    height: 1.25rem;
    width: 1.25rem;
    color: var(--foreground-secondary);
    transition: color 250ms ease;
  }

  :global(::view-transition-group(*)) {
    animation-duration: 500ms;
    transition-timing-function: ease;
  }

  :global(::view-transition-old(root)) {
    transform-origin: top center;
    animation: fade-out 400ms ease;
  }

  :global(::view-transition-new(root)) {
    transform-origin: top center;
    animation: fade-in 400ms ease;
  }

  @keyframes fade-out {
    to {
      transform: scale(0.8);
      opacity: 0;
    }
  }

  @keyframes fade-in {
    0% {
      transform: scale(0.8);
      opacity: 0;
    }
  }
</style>

<script is:inline>
  const applyTheme = () => {
    if (
      (window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: dark)").matches &&
        localStorage.getItem("theme") !== "light") ||
      localStorage.getItem("theme") === "dark"
    ) {
      document.documentElement.classList.toggle("dark", true);
    }
  };

  applyTheme();

  document.addEventListener("astro:after-swap", applyTheme);
</script>

<script>
  let returningFromId = null;

  document.addEventListener("astro:before-preparation", (event) => {
    const from = event.from.pathname;
    const to = event.to.pathname;

    if (from === "/") {
      const target = document.querySelector(`[href="${to}"]`);
      target?.classList.toggle("active", true);
    }

    if (to === "/") {
      returningFromId = from.replaceAll("/", "");
      document.addEventListener(
        "astro:after-preparation",
        () => {
          const target = event.newDocument.querySelector(
            `[href="/${returningFromId}"]`
          );
          target?.classList.toggle("active", true);
        },
        { once: true }
      );
    }
  });

  document.addEventListener("astro:page-load", () => {
    document
      .querySelector(".project-tile.active")
      ?.classList.toggle("active", false);

    // Chrome won't paint the <video> nodes the transition adopts from the
    // fetched index, leaving blank tiles. Cloning rebuilds them in the live
    // document, forcing a paint. Skip the persisted (still-painting) one.
    if (returningFromId !== null) {
      document.querySelectorAll("video").forEach((video) => {
        if (video.dataset.astroTransitionPersist === returningFromId) return;
        const clone = video.cloneNode(true);
        video.replaceWith(clone);
        clone.play?.().catch(() => {});
      });
      returningFromId = null;
    }
  });
</script>
